rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(tenantId, roles) {
      return request.auth != null
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role in roles;
    }
    function manager(tenantId) { return hasRole(tenantId, ['manager']); }
    match /tenants/{tenantId}/assignments/{assignmentId} {
      allow read: if manager(tenantId) || (hasRole(tenantId, ['driver']) && resource.data.driverUid == request.auth.uid && resource.data.active == true);
      allow write: if false;
    }
    match /tenants/{tenantId}/fuelRequests/{requestId} {
      allow read: if hasRole(tenantId, ['manager', 'accountant'])
        || (hasRole(tenantId, ['driver']) && resource.data.driverUid == request.auth.uid);
      allow write: if false;
    }
    match /tenants/{tenantId}/settings/fuel {
      allow get: if manager(tenantId);
      allow list, write: if false;
    }
    match /tenants/{tenantId}/customers/{customerId} {
      allow read: if manager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/vehicles/{vehicleId} {
      allow read: if manager(tenantId);
      // Vehicle creation and audit are atomic in the trusted callable.
      allow create: if false;
      allow update, delete: if false;
    }
    // A user may read only their own active profile in an active tenant.
    // Role and membership are provisioned exclusively by trusted administration.
    match /tenants/{tenantId}/users/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && resource.data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true;
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
