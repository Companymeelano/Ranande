rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(tenantId, roles) {
      return request.auth != null
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role in roles;
    }
    function manager(tenantId) { return hasRole(tenantId, ['manager']); }
    match /tenants/{tenantId}/assignments/{assignmentId} {
      allow read: if manager(tenantId) || (hasRole(tenantId, ['driver']) && resource.data.driverUid == request.auth.uid && resource.data.active == true);
      allow write: if false;
    }
    match /tenants/{tenantId}/fuelRequests/{requestId} {
      allow read: if hasRole(tenantId, ['manager', 'accountant'])
        || (hasRole(tenantId, ['driver']) && resource.data.driverUid == request.auth.uid);
      allow write: if false;
    }
    match /tenants/{tenantId}/vehicles/{vehicleId} {
      allow read: if manager(tenantId);
      allow create: if manager(tenantId)
        && request.resource.data.keys().hasOnly(['plate', 'model', 'tankCapacityMl', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['plate', 'model', 'tankCapacityMl', 'active', 'createdAt', 'createdBy'])
        && request.resource.data.plate is string && request.resource.data.plate.size() > 0 && request.resource.data.plate.size() <= 40
        && request.resource.data.model is string && request.resource.data.model.size() > 0 && request.resource.data.model.size() <= 100
        && request.resource.data.tankCapacityMl is int && request.resource.data.tankCapacityMl > 0 && request.resource.data.tankCapacityMl <= 10000000
        && request.resource.data.active == true && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    // A user may read only their own active profile in an active tenant.
    // Role and membership are provisioned exclusively by trusted administration.
    match /tenants/{tenantId}/users/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && resource.data.active == true
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.active == true;
      allow list, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
